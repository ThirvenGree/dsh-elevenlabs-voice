{
  "name": "dsh-elevenlabs-voice",
  "version": "1.3.3",
  "description": "Unified ElevenLabs DSH dictation, reply playback and Pet realtime voice",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "ACCEPTANCE.md",
    "LICENSE",
    "integrations",
    "scripts/install-pet-adapter.mjs",
    "scripts/pet-adapter-plan.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "conversation",
        "uiConversation",
        "sessions"
      ],
      "external": [
        "react",
        "react/jsx-runtime"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "prepack": "npm run check && npm test",
    "format": "prettier --write src test scripts package.json"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.32.0",
    "undici": "^7.16.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThirvenGree/dsh-elevenlabs-voice.git"
  },
  "license": "MIT"
}
